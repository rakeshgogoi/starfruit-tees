# Razorpay Key ID (public — used in frontend)
# Get from: Razorpay Dashboard → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# Razorpay credentials for the server-side API route
# NEVER commit real values. Add these in Vercel: Project Settings → Environment Variables
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
